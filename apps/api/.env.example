NODE_ENV=development
PORT=3000
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
# Unset: docs are served everywhere except production
# API_DOCS_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flowment
DB_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Comma-separated origins; empty disables CORS
CORS_ORIGINS=
# true behind a load balancer / reverse proxy
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

AI_PROVIDER="openai"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="your_openai_model"
